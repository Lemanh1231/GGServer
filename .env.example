# Guitar Girl Server - Environment Template
# Copy this file to .env and adjust values for your server:
#   cp .env.example .env

# Target public base URL (used by emulator server and patcher)
# For LAN testing: http://192.168.1.50:8080
# For Domain / Cloudflare Tunnel / HTTPS: https://your-domain.example
GG_PUBLIC_BASE=http://localhost:8080

# Server port (default 8080)
PORT=8080

# Web Dashboard Admin password
GG_ADMIN_PASSWORD=your_secure_password_here

# Directory containing original split APKs (default: orig_apk/)
# GG_APK_DIR=orig_apk
